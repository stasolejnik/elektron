<?xml version="1.0" encoding="utf-8"?>
<!-- Podgląd widżetu "Plan dnia" w pickerze launchera (Android 12+). Dane przykładowe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_preview_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_logo" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="Plan · Dziś" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/widget_text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1D PBŚ" android:textSize="12sp" android:textColor="@color/widget_text2" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:layout_marginBottom="2dp" android:background="@drawable/widget_preview_row_bg">
        <TextView android:layout_width="22dp" android:layout_height="wrap_content" android:text="3"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="matematyka"
                android:textSize="13sp" android:textColor="@color/widget_text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:55–09:40 · s. 105"
                android:textSize="11sp" android:textColor="@color/widget_text2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:layout_marginBottom="2dp" >
        <TextView android:layout_width="22dp" android:layout_height="wrap_content" android:text="4"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="j. polski"
                android:textSize="13sp" android:textColor="@color/widget_text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="09:50–10:35 · s. 108"
                android:textSize="11sp" android:textColor="@color/widget_text2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:layout_marginBottom="2dp" >
        <TextView android:layout_width="22dp" android:layout_height="wrap_content" android:text="5"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fizyka"
                android:textSize="13sp" android:textColor="@color/widget_text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:45–11:30 · s. 211"
                android:textSize="11sp" android:textColor="@color/widget_text2" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
