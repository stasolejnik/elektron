<?xml version="1.0" encoding="utf-8"?>
<!-- Układ startowy widżetów (initialLayout): to, co launcher pokazuje, zanim aplikacja narysuje widżet - np. tuż po
     restarcie telefonu. Tło widżetu w kolorze z motywu (jasne/ciemne) i logo, jak nagłówek widżetu. Dawniej domyślny
     układ Glance - jasny prostokąt z kółkiem ładowania, także w ciemnym motywie. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="top|start" android:padding="14dp"
    android:background="@drawable/widget_preview_bg">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_logo"
        android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="@string/app_name" android:textSize="15sp"
        android:textStyle="bold" android:textColor="@color/widget_text" />
</LinearLayout>
