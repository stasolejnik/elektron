<?xml version="1.0" encoding="utf-8"?>
<!-- Wiersz lekcji widżetu Plan dnia bez Glance (DayPlanListService) - wygląd jak LessonRow w DayPlanWidget. -->
<!-- Zewnętrzny FrameLayout daje odstęp 2 dp między wierszami (margines wiersza ListView nie działa poza tłem). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent"
    android:id="@+id/day_plan_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingBottom="2dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <!-- Tło podświetlonej lekcji (obrazek z filtrem koloru - patrz tło widżetu); bez podświetlenia ukryte. -->
    <ImageView android:id="@+id/day_plan_row_bg"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_day_plan_row_bg" android:scaleType="fitXY"
        android:visibility="gone" android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/day_plan_row_card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/day_plan_number"
            android:layout_width="26dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/day_plan_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1"
                android:ellipsize="end" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_plan_meta"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_plan_note"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"
                android:ellipsize="end" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_plan_user_note"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:ellipsize="end" android:visibility="gone"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
