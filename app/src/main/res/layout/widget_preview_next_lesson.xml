<?xml version="1.0" encoding="utf-8"?>
<!-- Podgląd widżetu "Następna lekcja" w pickerze launchera (Android 12+). Dane przykładowe.
     Tylko elementy dozwolone w RemoteViews (FrameLayout, LinearLayout, TextView, ImageView...) -
     zwykły <View> powodował "Problem podczas ładowania widżetu". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_preview_bg">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_logo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:text="TERAZ" android:textSize="11sp"
            android:textStyle="bold" android:textColor="@color/widget_accent" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="3" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="matematyka" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_text" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="08:55–09:40 · s. 105" android:textSize="12sp" android:textColor="@color/widget_text2" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_row_bg" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Zostało 20 min" android:textSize="11sp" android:textColor="@color/widget_accent" />
</LinearLayout>
