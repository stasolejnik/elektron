<?xml version="1.0" encoding="utf-8"?>
<!-- Widżet Plan dnia bez Glance (Android 17+, DayPlanClassic): lista z usługi DayPlanListService w widoku
     głównym widżetu - przewija się palcem. Wygląd jak wersja Glance (DayPlanWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_plan_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_classic_bg">
    <LinearLayout android:id="@+id/day_plan_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_logo"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/day_plan_label"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/day_plan_class"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/day_plan_day_end"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="11sp" android:fontFamily="sans-serif-medium"
        android:maxLines="1" android:visibility="gone" />
    <TextView android:id="@+id/day_plan_past"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="11sp"
        android:maxLines="1" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp">
        <ListView android:id="@+id/day_plan_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" android:overScrollMode="never" />
        <TextView android:id="@+id/day_plan_message"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="13sp" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
